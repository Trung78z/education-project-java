<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<?import java.lang.String?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<AnchorPane prefHeight="768.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/23.0.1"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.hcmuss.admin.controllers.DashboardController">

    <BorderPane fx:id="bp" prefHeight="768.0" prefWidth="1280.0">
        <top>
            <HBox fx:id="navbar" prefHeight="60.0" prefWidth="1280.0"
                style="-fx-background-color: #FFFFFF;" BorderPane.alignment="CENTER">

                <Pane prefHeight="60.0" prefWidth="160.0">

                    <Label contentDisplay="CENTER" layoutX="55.0" layoutY="19.0" text="Box car">
                        <padding>
                            <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
                        </padding>
                        <font>
                            <Font name="System Bold" size="15.0" />
                        </font>
                    </Label>
                    <ImageView fitHeight="20.0" fitWidth="20.0" layoutX="24.0" layoutY="19.0"
                        pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../images/boxcar.png" />
                        </image>
                    </ImageView>

                </Pane>
                <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="543.0">
                    <children>

                        <Text fx:id="title" strokeType="OUTSIDE" strokeWidth="0.0" text="Overview">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                            <HBox.margin>
                                <Insets left="20.0" />
                            </HBox.margin>
                        </Text>
                    </children>
                    <HBox.margin>
                        <Insets left="40.0" />
                    </HBox.margin>
                </HBox>
                <HBox alignment="CENTER_RIGHT" prefHeight="60.0" prefWidth="577.0">
                    <children>
                        <Button fx:id="logout" mnemonicParsing="false" onAction="#handleLogout"
                            styleClass="btn_logout"
                            text="Logout">
                            <opaqueInsets>
                                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                            </opaqueInsets>
                        </Button>
                    </children>
                    <HBox.margin>
                        <Insets right="40.0" />
                    </HBox.margin>
                </HBox>

            </HBox>
        </top>
        <left>
            <VBox fx:id="sidebar" prefHeight="708.0" prefWidth="160.0"
                style="-fx-background-color: white;" BorderPane.alignment="CENTER">
                <!--                <Separator orientation="VERTICAL" prefHeight="60.0"
                style="-fx-background-color: blue;" fx:id="separator" visible="false"/>-->
                <Pane fx:id="paneDashboard" onMouseClicked="#dashboard" prefHeight="60.0"
                    prefWidth="200.0">
                    <Label alignment="CENTER" contentDisplay="CENTER" layoutX="55.0" layoutY="21.0"
                        mnemonicParsing="false" text="Dashboard" textAlignment="CENTER"
                        textFill="#1307ff">
                        <font>
                            <Font name="System Bold" size="13.0" />
                        </font>
                    </Label>
                    <ImageView fitHeight="20.0" fitWidth="20.0" layoutX="27.0" layoutY="21.0"
                        pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../images/Dashboard.png" />
                        </image>
                    </ImageView>

                </Pane>
                <Pane fx:id="paneTransaction" onMouseClicked="#transaction" prefHeight="60.0"
                    prefWidth="200.0">
                    <Label layoutX="55.0" layoutY="21.0" mnemonicParsing="false" text="Transaction"
                        textFill="#4d4d4d">
                        <font>
                            <Font name="System Bold" size="13.0" />
                        </font>
                    </Label>
                    <ImageView fitHeight="20.0" fitWidth="20.0" layoutX="27.0" layoutY="21.0"
                        pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../images/transfer-gray.png" />
                        </image>
                    </ImageView>

                </Pane>
                <Pane fx:id="paneAccount" onMouseClicked="#account" prefHeight="60.0"
                    prefWidth="200.0">
                    <Label layoutX="55.0" layoutY="21.0" mnemonicParsing="false" text="Account"
                        textFill="#4d4d4d">
                        <font>
                            <Font name="System Bold" size="13.0" />
                        </font>
                    </Label>
                    <ImageView fitHeight="20.0" fitWidth="20.0" layoutX="27.0" layoutY="21.0"
                        pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../images/account-gray.png" />
                        </image>
                    </ImageView>

                </Pane>
                <Pane fx:id="paneProduct" onMouseClicked="#product" prefHeight="60.0"
                    prefWidth="200.0">
                    <Label layoutX="55.0" layoutY="21.0" mnemonicParsing="false" text="Product"
                        textFill="#4d4d4d">
                        <font>
                            <Font name="System Bold" size="13.0" />
                        </font>
                    </Label>
                    <ImageView fitHeight="20.0" fitWidth="20.0" layoutX="27.0" layoutY="21.0"
                        pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../images/product-gray.png" />
                        </image>
                    </ImageView>

                </Pane>
                <Pane fx:id="paneNews" onMouseClicked="#news" prefHeight="60.0" prefWidth="200.0">
                    <Label layoutX="55.0" layoutY="21.0" mnemonicParsing="false" text="News"
                        textFill="#4d4d4d">
                        <font>
                            <Font name="System Bold" size="13.0" />
                        </font>
                    </Label>
                    <ImageView fitHeight="20.0" fitWidth="20.0" layoutX="27.0" layoutY="21.0"
                        pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../images/new-gray.png" />
                        </image>
                    </ImageView>

                </Pane>
                <!-- <Pane fx:id="paneSetting" onMouseClicked="#setting" prefHeight="60.0"
                      prefWidth="200.0">
                    <Label layoutX="55.0" layoutY="21.0" mnemonicParsing="false" text="Setting"
                           textFill="#4d4d4d">
                        <font>
                            <Font name="System Bold" size="13.0" />
                        </font>
                    </Label>
                    <ImageView fitHeight="20.0" fitWidth="20.0" layoutX="27.0" layoutY="21.0"
                               pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../images/setting-gray.png" />
                        </image>
                    </ImageView>

                </Pane> -->

            </VBox>
        </left>
        <center>
            <AnchorPane prefHeight="708.0" prefWidth="1120.0" style="-fx-background-color: #DDDDDD;"
                BorderPane.alignment="CENTER" fx:id="ap">
                <children>

                    <AnchorPane layoutX="38.0" layoutY="64.0" prefHeight="311.0" prefWidth="589.0"
                    >
                        <styleClass>
                            <String fx:value="white-bg" />
                            <String fx:value="shadow" />
                        </styleClass>
                        <children>
                            <BarChart layoutX="10.0" layoutY="10.0" prefHeight="292.0"
                                prefWidth="642.0">
                                <xAxis>
                                    <CategoryAxis side="BOTTOM" />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis side="LEFT" />
                                </yAxis>
                            </BarChart>
                        </children>
                    </AnchorPane>
                    <Label layoutX="733.0" layoutY="22.0" text="Expense Statistics">
                        <font>
                            <Font name="Arial" size="18.0" />
                        </font>
                    </Label>
                    <AnchorPane layoutX="733.0" layoutY="64.0" prefHeight="311.0" prefWidth="360.0"
                    >
                        <styleClass>
                            <String fx:value="white-bg" />
                            <String fx:value="shadow" />
                        </styleClass>
                        <children>
                            <PieChart layoutX="20.0" layoutY="20.0" prefHeight="272.0"
                                prefWidth="320.0" />
                        </children>
                    </AnchorPane>
                    <AnchorPane layoutX="38.0" layoutY="434.0" prefHeight="243.0" prefWidth="667.0"
                    >
                        <styleClass>
                            <String fx:value="white-bg" />
                            <String fx:value="shadow" />
                        </styleClass>
                        <children>
                            <BarChart layoutX="27.0" layoutY="14.0" prefHeight="214.0"
                                prefWidth="808.0">
                                <xAxis>
                                    <CategoryAxis side="BOTTOM" />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis side="LEFT" />
                                </yAxis>
                            </BarChart>
                        </children>
                    </AnchorPane>
                    <Label layoutX="38.0" layoutY="22.0" text="Weekly Activity">
                        <font>
                            <Font name="Arial" size="18.0" />
                        </font>
                    </Label>
                    <Label layoutX="38.0" layoutY="394.0" text="Sales History">
                        <font>
                            <Font name="Arial" size="18.0" />
                        </font>
                    </Label>
                </children>
            </AnchorPane>
        </center>
    </BorderPane>

</AnchorPane>